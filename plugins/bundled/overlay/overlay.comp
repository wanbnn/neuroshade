#version 450
layout(local_size_x = 64) in;
layout(set = 0, binding = 0, std430) readonly buffer InputPixels { uint input_pixels[]; };
layout(set = 0, binding = 1, std430) writeonly buffer OutputPixels { uint output_pixels[]; };
layout(set = 0, binding = 2, std430) readonly buffer OverlayPixels { uint overlay_pixels[]; };
layout(push_constant) uniform Parameters { uint width; uint height; float strength; } parameters;
void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= parameters.width * parameters.height) return;
    uint src = input_pixels[i], ui = overlay_pixels[i], alpha = ui >> 24;
    if (alpha == 0u) { output_pixels[i] = src; return; }
    // CPU canvas is packed ARGB; swap red/blue for RGBA swapchains.
    if (parameters.strength < 0.0) ui = (ui & 0xff00ff00u) | ((ui & 255u) << 16) | ((ui >> 16) & 255u);
    uint out_pixel = src & 0xff000000u;
    for (uint shift = 0u; shift < 24u; shift += 8u)
        out_pixel |= ((((src >> shift) & 255u) * (255u-alpha) + ((ui >> shift) & 255u) * alpha) / 255u) << shift;
    output_pixels[i] = out_pixel;
}
