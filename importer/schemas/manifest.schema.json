{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://neuroshade.dev/schemas/manifest.schema.json",
  "title": "NeuroShade .nsmodel manifest",
  "description": "Mirrors src/neural/model/package.cpp:273..299 — the C++ loader is the source of truth and this schema is for documentation / spot-checks only.",
  "type": "object",
  "required": [
    "schema",
    "id",
    "name",
    "version",
    "runtime",
    "inputs",
    "output",
    "history",
    "scale",
    "first_frame",
    "shapes"
  ],
  "properties": {
    "schema": { "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "runtime": { "const": "migraphx" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["semantic", "tensor", "dtype", "layout"],
        "properties": {
          "semantic": { "type": "string" },
          "tensor":   { "type": "string", "minLength": 1 },
          "dtype":    { "enum": ["fp16", "fp32"] },
          "layout":   { "enum": ["NCHW", "NHWC"] },
          "optional": { "type": "boolean" }
        }
      }
    },
    "output": {
      "type": "object",
      "required": ["semantic", "tensor", "dtype", "layout"],
      "properties": {
        "semantic": { "type": "string" },
        "tensor":   { "type": "string", "minLength": 1 },
        "dtype":    { "enum": ["fp16", "fp32"] },
        "layout":   { "enum": ["NCHW", "NHWC"] }
      }
    },
    "history":     { "type": "integer", "minimum": 0 },
    "scale":       { "type": "object", "required": ["x", "y"], "properties": { "x": { "type": "number" }, "y": { "type": "number" } } },
    "first_frame": { "enum": ["spatial", "copy", "zero-history", "reject"] },
    "shapes": {
      "type": "object",
      "required": ["kind", "buckets"],
      "properties": {
        "kind":     { "enum": ["fixed", "dynamic", "bucketed"] },
        "buckets": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["input", "output"],
            "properties": {
              "input":  { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } },
              "output": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 } }
            }
          }
        }
      }
    }
  }
}
