set(root "@CMAKE_BINARY_DIR@/soak-harness-test")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
foreach(mode IN ITEMS testbed temporal)
    execute_process(
        COMMAND /bin/sh "@CMAKE_SOURCE_DIR@/tests/soak/run-soak.sh"
            --mode "${mode}" --build-dir "@CMAKE_BINARY_DIR@"
            --iterations 2 --output "${root}/${mode}.txt"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(NOT result EQUAL 0 OR NOT output MATCHES "iterations=2" OR
       NOT output MATCHES "failures=0")
        message(FATAL_ERROR "${mode} soak harness failed: ${output} ${error}")
    endif()
endforeach()
message(STATUS "reliability.soak_harness: PASS short_contract_only=yes")
